# Backup your existing config (if you want to keep it)
mv ~/.config/nvim ~/.config/nvim.backup

# Create fresh directory
mkdir -p ~/.config/nvim

# Clean up lazy installation
rm -rf ~/.local/share/nvim/lazy


nvim ~/.config/nvim/init.lua


-- Print debug info
print("Starting Neovim configuration...")

-- Set leader key first
vim.g.mapleader = " "
vim.g.maplocalleader = " "

-- Bootstrap lazy.nvim
local lazypath = vim.fn.stdpath("data") .. "/lazy/lazy.nvim"
print("Lazy.nvim path: " .. lazypath)

if not vim.loop.fs_stat(lazypath) then
  print("Installing lazy.nvim...")
  vim.fn.system({
    "git",
    "clone",
    "--filter=blob:none",
    "https://github.com/folke/lazy.nvim.git",
    "--branch=stable",
    lazypath,
  })
  print("Lazy.nvim installation complete")
end

vim.opt.rtp:prepend(lazypath)
print("Added lazy.nvim to runtimepath")

-- Initialize lazy.nvim
local status_ok, lazy = pcall(require, "lazy")
if not status_ok then
  print("Failed to load lazy.nvim: " .. tostring(lazy))
  return
end

print("Lazy.nvim loaded successfully")

lazy.setup({
  -- Plugins will go here
})


in init.lua

lazy.setup({
  -- Add these theme plugins
  { "folke/tokyonight.nvim" },
  { "catppuccin/nvim", name = "catppuccin" },
  { "rose-pine/neovim", name = "rose-pine" },
})


-- Show line numbers
vim.opt.number = true       -- Show line numbers
vim.opt.relativenumber = true   -- Show relative line numbers (optional)
-- After the setup, add this line to set a theme
vim.cmd[[colorscheme tokyonight]]
